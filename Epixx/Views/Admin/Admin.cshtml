@{
    Layout = "_AdminLayout";
}
<div class="table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Användarnamn</th>
                <th>Roll</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Role</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="table-actions">
        <a asp-action="CreateUser" class="admin-btn">
            Skapa ny användare
        </a>

        <a asp-action="Index"
           asp-controller="Home"
           class="admin-btn secondary">
            Tillbaka till meny
        </a>
    </div>
</div>
