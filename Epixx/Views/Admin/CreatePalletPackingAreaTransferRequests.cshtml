@using Epixx.Models.DTO
@{
    Layout = "_AdminLayout";
}
@model PalletCountAndStoreListDTO
<div class="double-table-container" data-type="Awaiting PackingAreaTransfer">
    <div class="table-container">
        <h2>Välj butik:</h2>

        <select id="store-picker" class="form-control">
            @foreach (var store in Model.Stores)
            {
                <option value="@store.Id">@store.Name</option>
            }
        </select>
        <h2>Välj datum:</h2>
        <input id="date-picker-for-transfer" type="date" class="form-control" />
        <h3>Redan existerande ordrar:</h3>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Artikel</th>
                    <th>Flytta antal</th>
                </tr>
            </thead>
            <tbody id="tbody-for-day">
            </tbody>
        </table>
    </div>
    <div class="table-container">
    <h2>Flytta pall till plock</h2>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Artikel</th>
                    <th>Tillgängliga</th>
                    <th>Flytta antal</th>
                </tr>
            </thead>
            <tbody id="available-pallets-body">
                @foreach(var pallet in Model.PalletCount)
                {
                    <tr class="transfer-field">
                        <td class="transfer-description">@pallet.Description</td>
                        <td>@pallet.Count</td>
                        <td>
                            <input type="number"
                                    min="0"
                                    max="@pallet.Count"
                                    value="0"
                                    data-max="@pallet.Count"
                                    class="qty-input" />
                        </td>

                    </tr>
                }

            </tbody>
        </table>

        <button type="button" id="submitBtn" disabled>
            Skapa order
        </button>
    </div>
</div>