@model Epixx.Models.DTO.IndexDTO
<div class="menu-container">
    <div class="menu">
        <img src="~/images/EpixxLogo.png"
             alt="Epixx"
             class="epixx-logo-big" />
        <a href="/Auto/FindAutoMission" class="menu-btn @(Model.Count == 0 ? "disabled-btn" : "")">
            Automatiska Uppdrag
        </a>
        <a href="/Warehouse/InboundLogistics" class="menu-btn">
            Inleverans
        </a>
       
        <a href="/Admin" class="menu-btn">
            Lager och Pallhantering
        </a>
        <a href="/Picking/AutomaticPickingMission" class="menu-btn">
