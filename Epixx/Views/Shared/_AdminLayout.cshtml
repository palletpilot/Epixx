<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin/admin-base.css" />
    <link rel="stylesheet" href="~/css/admin/admin-navigation.css" />
    <link rel="stylesheet" href="~/css/admin/admin-tables.css" />
    <link rel="stylesheet" href="~/css/admin/admin-forms.css" />
    <link rel="stylesheet" href="~/css/admin/admin-missions.css" />
    <link rel="stylesheet" href="~/css/admin/admin-transfers.css" />
    <link rel="stylesheet" href="~/css/admin/admin-feedback.css" />
</head>
<body>
    @* Include the admin menu *@
    @await Html.PartialAsync("_AdminMenu")

    <div class="admin-content">
        @RenderBody()
    </div>
    <div id="admin-notification"
         class="admin-notification notification-info hidden">

        <span id="notification-message"></span>

    </div>
    @await Html.PartialAsync("_ConfirmWindow")
    <script src="~/js/Admin.js" asp-append-version="true"></script>
    <script src="~/js/AdminPalletTransfer.js" asp-append-version="true"></script>
    <script src="~/js/SendOutPallets.js" asp-append-version="true"></script>
    @if (TempData["Notification"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
            showNotification(
            @Json.Serialize(TempData["Notification"]),
            @Json.Serialize(TempData["NotificationType"] ?? "info")
            );
            });
        </script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>