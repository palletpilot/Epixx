<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Epix</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storeinbound.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inbound.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/PalletToStore.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/PalletTransfer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Epixx.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Picking.css" asp-append-version="true" />

</head>
<body>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/storeinbound.js" asp-append-version="true"></script>
    <script src="~/js/PalletToStore.js" asp-append-version="true"></script>
    <script src="~/js/PalletTransfer.js" asp-append-version="true"></script>
    <script src="~/js/PalletTransferConfirmation.js" asp-append-version="true"></script>

    <script src="~/js/inbound.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
