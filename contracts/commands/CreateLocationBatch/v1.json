{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lagerkraft:commands/CreateLocationBatch/v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["warehouse_id", "type", "locations"],
  "properties": {
    "warehouse_id": { "type": "string", "format": "uuid" },
    "parent_id": { "type": ["string", "null"], "format": "uuid" },
    "type": { "type": "string", "enum": ["zone", "aisle", "rack", "level", "bin", "floor", "dock"] },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "code"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string", "minLength": 1 },
          "parent_id": { "type": ["string", "null"], "format": "uuid" }
        }
      }
    }
  }
}
