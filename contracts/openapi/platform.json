            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AssignRoleRequest": {
        "required": [
          "role",
          "warehouse_id"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "warehouse_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "ChooseTenantRequest": {
        "required": [
          "chooser_token",
          "tenant_id"
        ],
        "type": "object",
        "properties": {
          "chooser_token": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ConvertTrialRequest": {
        "required": [
          "plan_code",
          "billing_interval",
          "legal_name",
          "org_number",
          "billing_email",
          "address_line1",
          "postal_code",
          "city",
          "country",
          "vat_number"
        ],
        "type": "object",
        "properties": {
          "plan_code": {
            "type": [
              "null",
              "string"
            ]
          },
          "billing_interval": {
            "type": [
              "null",
              "string"
            ]
          },
          "legal_name": {
            "type": [
              "null",
              "string"
            ]
          },
          "org_number": {
            "type": [
              "null",
              "string"
            ]
          },
          "billing_email": {
            "type": [
              "null",
              "string"
            ]
          },
          "address_line1": {
            "type": [
              "null",
              "string"
            ]
          },
          "postal_code": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          },
          "vat_number": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateEnrollmentCodeRequest": {
        "required": [
          "warehouse_ids"
        ],
        "type": "object",
        "properties": {
          "warehouse_ids": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CreateInvitationRequest": {
        "required": [
          "email",
          "role",
          "warehouse_ids"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "warehouse_ids": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "DeviceBeaconRequest": {
        "required": [
          "pending_count",
          "oldest_pending_occurred_at",
          "last_sync_at",
          "sse_connected"
        ],
        "type": "object",
        "properties": {
          "pending_count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "oldest_pending_occurred_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "last_sync_at": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "sse_connected": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "EnrollDeviceRequest": {
        "required": [
          "code",
          "name",
          "device_id"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "device_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password",
          "totp"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totp": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LogoutRequest": {
        "required": [
          "refresh_token"
        ],
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        }
      },
      "MigrationStatusRequest": {
        "required": [
          "schemaVersion",
          "migrationStatus",
          "lastError"
        ],
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "migrationStatus": {
            "type": "string"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OidcCallbackRequest": {
        "required": [
          "state",
          "id_token",
          "code"
        ],
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "id_token": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OidcStartRequest": {
        "required": [
          "email",
          "slug"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "slug": {
