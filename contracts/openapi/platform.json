  "components": {
    "schemas": {
      "AcceptInvitationRequest": {
        "required": [
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ApproveJoinRequest": {
        "required": [
